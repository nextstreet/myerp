# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
APP_API_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgresql://listing_console:listing_console@localhost:5432/listing_console
DATABASE_SSL=false

# Local media storage (replace with an S3-compatible adapter in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_IMAGE_BYTES=15000000
MAX_VIDEO_BYTES=250000000

# AI provider. Never commit a real key.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Mercado Libre. Keep real values only in server-side secrets.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_PUBLISH_ENABLED=false
MELI_API_BASE_URL=https://api.mercadolibre.com
