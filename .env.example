# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
APP_API_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:8080

# Built-in visual console. Generate values locally; never commit real values.
CONSOLE_PUBLIC_URL=https://mercado.cybertao.space
CONSOLE_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
CONSOLE_SESSION_SECRET=
CONSOLE_SESSION_TTL_SECONDS=28800

# PostgreSQL
POSTGRES_DB=listing_console
POSTGRES_USER=listing_console
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://listing_console:replace-with-a-long-random-database-password@postgres:5432/listing_console
DATABASE_SSL=false

# Local media storage (replace with an S3-compatible adapter in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_IMAGE_BYTES=15000000
MAX_VIDEO_BYTES=250000000

# AI provider. Never commit a real key.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional separate multimodal and image models. Keep real keys on the server.
AI_VISION_MODEL=
AI_IMAGE_MODEL=
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_IMAGES=8
AI_MAX_INPUT_IMAGE_BYTES=5000000
AI_GENERATED_IMAGE_SIZE=1024x1024

# Mercado Libre. Keep real values only in server-side secrets.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://mercado.cybertao.space/oauth/callback
MELI_SCOPE=offline_access
MELI_AUTH_BASE_URL=https://global-selling.mercadolibre.com
MELI_API_BASE_URL=https://api.mercadolibre.com
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional Appsmith page after a successful callback.
OAUTH_SUCCESS_REDIRECT_URL=
OAUTH_STATE_TTL_SECONDS=600
TOKEN_REFRESH_INTERVAL_SECONDS=600
MELI_PUBLISH_ENABLED=false
