    "db:seed": "node scripts/seed-test-product.js",
    "meli:refresh-tokens": "node scripts/refresh-tokens.js",
    "console:hash-password": "node scripts/hash-console-password.js",
    "test": "node --test",
    "check": "node --check src/index.js && node --test"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
