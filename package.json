{
  "name": "mercado-libre-ai-listing-console",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "Lightweight AI-assisted Mercado Libre listing console for Mexico, Colombia and Chile.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
